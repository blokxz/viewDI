    {"id": "gh", "group": "engine", "title": "Upstream releases", "detail": "moby/moby, lxc/incus\n(ETag cache)", "role": "external", "icon": "github"},
    {"id": "channel", "group": "engine", "title": "Channel filter", "detail": "Incus LTS vs stable"},
