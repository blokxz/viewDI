# Maintainer: blokxz <noreply@users.noreply.github.com>
# Generated checksums: scripts/aur-update.py <version> fills pkgver, pkgrel and the sha256sums
# from the release's checksums.txt and rewrites .SRCINFO. Publish by hand (see README.md here).
pkgname=viewdi-bin
pkgver=1.0.0
pkgrel=1
pkgdesc='Terminal UI to manage and monitor Docker and Incus side by side'
arch=('x86_64' 'aarch64')
url='https://github.com/blokxz/viewDI'
license=('Apache-2.0')
optdepends=('docker: manage Docker containers'
            'incus: manage Incus containers and VMs')
provides=('viewdi')
conflicts=('viewdi')
options=('!strip')
install=viewdi.install
source_x86_64=("viewdi-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/viewdi_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("viewdi-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/viewdi_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  # The tarball has no top-level directory: makepkg extracts it into $srcdir.
  install -Dm755 viewdi "$pkgdir/usr/bin/viewdi"
  install -Dm644 man/man1/viewdi.1 "$pkgdir/usr/share/man/man1/viewdi.1"
  install -Dm644 completions/completion.bash "$pkgdir/usr/share/bash-completion/completions/viewdi"
  install -Dm644 completions/completion.zsh "$pkgdir/usr/share/zsh/site-functions/_viewdi"
  install -Dm644 completions/completion.fish "$pkgdir/usr/share/fish/vendor_completions.d/viewdi.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
